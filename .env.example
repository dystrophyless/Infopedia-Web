# General
APP_NAME=Infopedia
SECRET_KEY=...
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LLMWHISPERER_API_KEY=...

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=PgAdminSecurePass42!
PGADMIN_PORT=5050

# Redis
REDIS_DB=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default # <- Не менять!
REDIS_PASSWORD=default

# RabbitMQ
RABBITMQ_USER=default
RABBITMQ_PASSWORD=default
RABBITMQ_VHOST=bot_vhost

# Celery
CELERY_BROKER_URL=amqp://default:default@rabbitmq:5672/bot_vhost
CELERY_RESULT_BACKEND=redis://default:default@redis:6379/1
CELERY_RESULT_EXPIRES_SECONDS=3600

# Anti-scrape
ANTI_SCRAPE_ENABLED=true
ANTI_SCRAPE_BLOCK_AUTOMATION_USER_AGENTS=true
ANTI_SCRAPE_WINDOW_SECONDS=60
ANTI_SCRAPE_AUTHENTICATED_LIMIT=90
ANTI_SCRAPE_PUBLIC_LIMIT=30
ANTI_SCRAPE_SEARCH_LIMIT=45
ANTI_SCRAPE_DETAIL_LIMIT=60
ANTI_SCRAPE_MAX_SEARCH_RESULTS=20
ANTI_SCRAPE_MAX_TERMS_PAGE_SIZE=20

# OAuth
RESEND_API_KEY=re_...
EMAIL_FROM=Infopedia <onboarding@resend.dev>
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=GOSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Registration
VERIFICATION_CODE_EXPIRE_MINUTES=10
REGISTRATION_MAX_ATTEMPTS=5
REGISTRATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
PASSWORD_ATTEMPT_LIMIT=10
PASSWORD_ATTEMPT_WINDOW_SECONDS=60
