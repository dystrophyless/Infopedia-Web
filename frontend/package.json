{
  "name": "infopedia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit --incremental false",
    "lint": "tsc -b --noEmit",
    "test": "npm run test:contracts && npm run test:unit",
    "test:contracts": "node src/ui/design-system.contract.test.mjs && node src/styles/theme.generated-css.test.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:design-system": "node src/ui/design-system.contract.test.mjs",
    "test:ui": "npm run test:design-system && npm run test-storybook",
    "test-storybook": "vitest run --project=storybook"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "axios": "^1.7.7",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.3",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/browser-playwright": "4.1.10",
    "autoprefixer": "^10.4.20",
    "playwright": "1.61.1",
    "postcss": "^8.4.47",
    "storybook": "10.4.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.1.10"
  }
}
